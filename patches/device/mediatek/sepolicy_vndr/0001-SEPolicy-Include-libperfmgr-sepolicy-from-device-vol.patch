From b9d730d9968ebd9496834b4dba8427e6cfd95964 Mon Sep 17 00:00:00 2001
From: bjgo78 <bjgo78@gmail.com>
Date: Tue, 24 Nov 2026 10:37:51 +0000
Subject: [PATCH] SEPolicy: Include libperfmgr sepolicy from device/voltage

VoltageOS syncs LineageOS's device/lineage/sepolicy as
device/voltage/sepolicy, so device/lineage/sepolicy/libperfmgr/
sepolicy.mk does not exist there and board config fails:

  device/mediatek/sepolicy_vndr/SEPolicy.mk:5: error:
  device/lineage/sepolicy/libperfmgr/sepolicy.mk: No such file or
  directory

Include the same file from device/voltage/sepolicy.
---
 SEPolicy.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/SEPolicy.mk b/SEPolicy.mk
index f57bfc1..e9dc1a5 100644
--- a/SEPolicy.mk
+++ b/SEPolicy.mk
@@ -2,7 +2,7 @@
 MTK_SEPOLICY_PATH := device/mediatek/sepolicy_vndr
 TRUSTY_DEVICE_PATH := device/generic/trusty
 
-include device/lineage/sepolicy/libperfmgr/sepolicy.mk
+include device/voltage/sepolicy/libperfmgr/sepolicy.mk
 
 BOARD_VENDOR_SEPOLICY_DIRS += $(MTK_SEPOLICY_PATH)/base/vendor
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(MTK_SEPOLICY_PATH)/base/private
-- 
2.43.0

